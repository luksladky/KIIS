{block content}

    <h1 class="page-header">Oprávnění uživatele {$profile->nickname}</h1>

    <a n:href="Profile:default" class="btn btn-default">Zpět na seznam kontaktů</a>
    <a n:href="Profile:show $profile->id" class="btn btn-default">Zpět na profil uživatele</a>
    <a n:href="Profile:editAllPermissions" class="btn btn-default">Správa oprávnění všech</a>

    <hr>
    {var $states = App\Model\PermissionRepository::groupStates($assignedRoles)}
    <table class="table table-hover table-responsive center-vertical">

        <thead>
        <tr>
            <th></th>
            <th>Oprávnění</th>
            <th>Co umožňuje</th>
        </tr>
        </thead>
        <tbody>

        {foreach $groups as $key => $group}
            <tr>
                <td>
                    {if $states[$key] === 'full'}
                        <a n:href="removeGroup! $profile->id, $key" class="btn btn-success btn-sm" title="Kliknutím odebereš">
                            <i class="glyphicon glyphicon-ok"></i> Má
                        </a>
                    {elseif $states[$key] === 'partial'}
                        <a n:href="addGroup! $profile->id, $key" class="btn btn-warning btn-sm" title="Kliknutím doplníš zbytek">
                            <i class="glyphicon glyphicon-adjust"></i> Částečně
                        </a>
                    {else}
                        <a n:href="addGroup! $profile->id, $key" class="btn btn-default btn-sm" title="Kliknutím přidáš">
                            <i class="glyphicon glyphicon-minus"></i> Nemá
                        </a>
                    {/if}
                </td>
                <td><strong>{$group['label']}</strong></td>
                <td>{$group['description']}</td>
            </tr>
        {/foreach}
        </tbody>
    </table>

    <p class="text-muted">Přidáním jakéhokoli oprávnění se uživatel stane i členem. Změny se projeví po jeho dalším přihlášení.</p>
{/block}
